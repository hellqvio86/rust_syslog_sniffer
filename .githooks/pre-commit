#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

if [[ -d "${HOME}/.local/bin" && ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

echo "=========================================="
echo "Running fast pre-commit checks..."
echo "=========================================="

echo "--> [1/3] Checking code formatting..."
cargo fmt -- --check

echo "--> [2/3] Checking linter (clippy)..."
cargo clippy --locked --all-targets -- -D warnings

echo "--> [3/3] Scanning secrets on staged diff..."
if command -v trufflehog >/dev/null 2>&1; then
    trufflehog --no-update git file://"$(pwd)" --since-commit HEAD --only-verified --fail
elif command -v docker >/dev/null 2>&1; then
    docker run --rm -v "$(pwd):/src" -w /src trufflesecurity/trufflehog:3.99.8 git file:///src --since-commit HEAD --only-verified --fail
fi

echo "=========================================="
echo "Pre-commit checks passed!"
echo "=========================================="
